# Node Environment
NODE_ENV=production
PORT=3000

# PostgreSQL Multi-Tenant Database
DATABASE_URL=postgresql://codshop_user:codshop_secret_password@localhost:5432/codshop_db

# SaaS Domain & Multi-Tenant Wildcard Configuration
NEXT_PUBLIC_APP_URL=https://codshop.site
NEXT_PUBLIC_WILDCARD_DOMAIN=codshop.site

# Moroccan Courier API Credentials (Optional defaults for merchant auto-dispatch)
OZON_EXPRESS_API_TOKEN=ozon_live_demo_key
SENDIT_API_TOKEN=sendit_live_demo_key

# Payment Gateways (Optional)
STRIPE_SECRET_KEY=
CMI_MERCHANT_ID=
